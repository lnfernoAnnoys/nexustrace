# Settings for the NexusTrace server. setup-server.sh copies this to /etc/nexustrace.env.
# After editing that file, apply changes with:  sudo systemctl restart nexustrace

# The API listens on this port on the server itself; Caddy forwards the public website to it.
PORT=3001

# The public site is served over HTTPS, so login cookies are marked Secure.
# (Set to false ONLY if you are testing over plain http://IP-ADDRESS before the domain works.)
COOKIE_SECURE=true

# true  = anyone can create an account (they still have to set up an authenticator app)
# false = only accounts created with:  npm run user -- create <id> <password> --name "..."
SIGNUP_OPEN=true
