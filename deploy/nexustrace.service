[Unit]
Description=NexusTrace (the API and both websites)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/nexustrace.env
ExecStart=__APP_DIR__/node_modules/.bin/tsx server/index.ts --production
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
